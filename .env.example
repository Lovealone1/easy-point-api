# Copy to .env and fill in real values. Never commit .env.
# In production, every variable marked (prod) is enforced by validateConfig()
# in src/common/config/config.ts — the app refuses to start if missing.

NODE_ENV=development
PORT=3001
AUDIT_LOG_RETENTION_DAYS=30

API_BASE_URL="http://localhost:3001/api"
FRONTEND_URL="http://localhost:3000"

# Comma-separated list of allowed origins. (prod)
CORS_ORIGINS="http://localhost:3000"

# Proxy hops to trust for req.ip / x-forwarded-for.
# Local dev: false. Behind Caddy in compose.prod.yaml: 1 (one hop).
TRUST_PROXY=false

# Explicitly enable/disable Swagger + ReDoc.
# Defaults to `true` outside production and `false` in production if unset.
# SWAGGER_ENABLED=true

# ── JWT ──────────────────────────────────────────────────────────────────
# Required, no fallback. Generate distinct values with:
#   openssl rand -base64 48
# Rotating either secret invalidates every active session.
JWT_SECRET=""
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=""
JWT_REFRESH_EXPIRES_IN=30d

# ── Database (self-hosted PostgreSQL) ───────────────────────────────────────
# Two roles, deliberately:
#   DATABASE_URL → easypoint_app, unprivileged, SUBJECT to Row-Level Security.
#                  This is what the running application uses.
#   DIRECT_URL   → easypoint (schema owner), EXEMPT from RLS. Migrations + seed.
# compose.yaml / compose.prod.yaml override both to point at the `postgres`
# service automatically, so these values only matter outside Docker.
DATABASE_URL="postgresql://easypoint_app:changeme@localhost:5432/easypoint"
DIRECT_URL="postgresql://easypoint:changeme@localhost:5432/easypoint"

# Owner role — credentials for the `postgres` container itself
POSTGRES_USER=easypoint
POSTGRES_PASSWORD="changeme"
POSTGRES_DB=easypoint

# Application role. The enable_rls migration creates it WITHOUT a password
# (secrets don't belong in migrations), so it cannot authenticate until you run,
# once per environment:
#   ALTER ROLE easypoint_app WITH PASSWORD '<POSTGRES_APP_PASSWORD>';
POSTGRES_APP_USER=easypoint_app
POSTGRES_APP_PASSWORD="changeme"

# Optional: dedicated databases for tenants requiring physical isolation, as
# id=connectionString pairs matching Organization.databaseId. Organizations
# default to "default" (the shared database above) and need nothing here.
# TENANT_DATABASE_URLS="acme=postgresql://user:pass@host:5432/acme"

# ── Supabase (Storage only — DB no longer used) ─────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=

# ── SMTP ─────────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── Redis ────────────────────────────────────────────────────────────────
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD="changeme"
REDIS_DB=0
REDIS_TTL_SECONDS=300
REDIS_KEY_PREFIX=easy-point

# ── Rate limiting ────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=false
RATE_LIMIT_GLOBAL_REQUESTS=10000
RATE_LIMIT_GLOBAL_WINDOW=1m
RATE_LIMIT_STRICT_IP_REQUESTS=5
RATE_LIMIT_STRICT_IP_WINDOW=1h
RATE_LIMIT_MODERATE_IP_REQUESTS=100
RATE_LIMIT_MODERATE_IP_WINDOW=1m
RATE_LIMIT_READ_REQUESTS=300
RATE_LIMIT_READ_WINDOW=1m
RATE_LIMIT_WRITE_REQUESTS=30
RATE_LIMIT_WRITE_WINDOW=1m

# ── S3 Storage (Supabase Storage, R2, MinIO, etc.) ──────────────────────────
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME=""

# ── Subscription check cron & grace period ──────────────────────────────────
CRON_SUBSCRIPTION_CHECK="59 23 * * *"
SUBSCRIPTION_GRACE_PERIOD_DAYS=3

# ── Production only: Caddy / TLS ─────────────────────────────────────────
# DOMAIN=api.example.com
# ACME_EMAIL=admin@example.com

# ── Production only: encrypted off-site Postgres backups ───────────────────
# Defaults to the S3_* credentials above if unset. Point BACKUP_S3_* at a
# different bucket/provider (R2, Backblaze) if the DB backups should not
# share a bucket with app file storage.
# BACKUP_SCHEDULE="0 3 * * *"
# BACKUP_RETENTION_DAYS=14
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_BUCKET=
# BACKUP_S3_PREFIX=postgres-backups
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_ENCRYPTION_KEY=""

# Host port for the Postgres container (only affects local access from the host).
# Change it if your machine already runs Postgres on 5432.
# POSTGRES_HOST_PORT=5432
